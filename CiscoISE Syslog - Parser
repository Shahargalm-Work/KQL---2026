Syslog
| where HostName in~ ("cisco-ise-01","cisco-ise-02")
| extend EventType = case(
 ProcessName startswith "CISE_Passed_Authentications","ISEAuthSuccess",
 ProcessName startswith "CISE_RADIUS_Accounting","ISERadiusAccounting",
 ProcessName startswith "CISE_Failed_Attempts", "ISEAuthFailure",
  ProcessName startswith "CISE_TACACS_Accounting", "ISETacacsAccounting",
    ProcessName startswith "CISE_TACACS_Diagnostics", "ISETacacsDiagnostics",
    ProcessName startswith "CISE_Alarm", "ISEAlarm",
    ProcessName startswith "CISE_MONITORING_DATA_PURGE_AUDIT", "ISEAuditPurge",
 "Other")
 | extend//     --- Radius Accounting ---
    RadiusEventAction = case(EventType=="ISERadiusAccounting", extract(@"Radius-Accounting:\s*RADIUS Accounting ([^,]+)", 1, SyslogMessage), ""),
    DeviceIP = case(EventType=="ISERadiusAccounting", extract(@"Device IP Address=([^,]+)", 1, SyslogMessage), ""),
    NetworkDeviceName = case(EventType=="ISERadiusAccounting", extract(@"NetworkDeviceName=([^,]+)", 1, SyslogMessage), ""),
    Username = case(EventType=="ISERadiusAccounting", extract(@"UserName=([^,]+)", 1, SyslogMessage), ""),
    FramedIP = case(EventType=="ISERadiusAccounting", extract(@"Framed-IP-Address=([^,]+)", 1, SyslogMessage), ""),
    CallingStationIP = case(EventType=="ISERadiusAccounting", extract(@"Calling-Station-ID=([^,]+)", 1, SyslogMessage), ""),
    CalledStationIP = case(EventType=="ISERadiusAccounting", extract(@"Called-Station-ID=([^,]+)", 1, SyslogMessage), ""),
    NasIdentifier = case(EventType=="ISERadiusAccounting", extract(@"NAS-Identifier=([^,]+)", 1, SyslogMessage), ""),
    NasPort = case(EventType=="ISERadiusAccounting", extract(@"NAS-Port=([^,]+)", 1, SyslogMessage), ""),
    AccountingStatus = case(EventType=="ISERadiusAccounting", extract(@"Acct-Status-Type=([^,]+)", 1, SyslogMessage), ""),
    SessionId = case(EventType=="ISERadiusAccounting", extract(@"Acct-Session-Id=([^,]+)", 1, SyslogMessage), ""),
    SessionDurationSeconds = case(EventType=="ISERadiusAccounting", extract(@"Acct-Session-Time=([^,]+)", 1, SyslogMessage), ""),
    TerminateCause = case(EventType=="ISERadiusAccounting", extract(@"Acct-Terminate-Cause=([^,]+)", 1, SyslogMessage), ""),
    AcsSessionId = case(EventType=="ISERadiusAccounting", extract(@"AcsSessionID=([^,]+)", 1, SyslogMessage), ""),
    CpmSessionId = case(EventType=="ISERadiusAccounting", extract(@"CPMSessionID=([^,]+)", 1, SyslogMessage), ""),
    AccessService = case(EventType=="ISERadiusAccounting", extract(@"SelectedAccessService=([^,]+)", 1, SyslogMessage), ""),
    TunnelVlan = case(EventType=="ISERadiusAccounting", extract(@"Tunnel-Private-Group-ID=\(tag=0\)\s*([^,]+)", 1, SyslogMessage), ""),
    ClientLatencyMs = case(EventType=="ISERadiusAccounting", extract(@"ClientLatency=([^,]+)", 1, SyslogMessage), ""),
    TotalAuthLatencyMs = case(EventType=="ISERadiusAccounting", extract(@"TotalAuthenLatency=([^,]+)", 1, SyslogMessage), ""),
    RadiusSteps = case(EventType=="ISERadiusAccounting", strcat_array(extract_all(@"Step=(\d+)", SyslogMessage), ","), "")
| extend//      --- Authentication Success ---
    AuthUser = case(EventType=="ISEAuthSuccess", extract(@"UserName=([^,]+)",1,SyslogMessage), ""),
    AuthResult = case(EventType=="ISEAuthSuccess", extract(@"AuthenticationStatus=([^,]+)",1,SyslogMessage), ""),
    AuthProtocol = case(EventType=="ISEAuthSuccess", extract(@"Protocol=([^,]+)",1,SyslogMessage), ""),
    AuthPrivilegeLevel = case(EventType=="ISEAuthSuccess", extract(@"Privilege-Level=(\d+)",1,SyslogMessage), ""),
    AuthDeviceIP = case(EventType=="ISEAuthSuccess", extract(@"Device IP Address=([^,]+)",1,SyslogMessage), ""),
    AuthDestinationIP = case(EventType=="ISEAuthSuccess", extract(@"DestinationIPAddress=([^,]+)",1,SyslogMessage), ""),
    AuthDestinationPort = case(EventType=="ISEAuthSuccess", extract(@"DestinationPort=(\d+)",1,SyslogMessage), ""),
    AuthRemoteIP = case(EventType=="ISEAuthSuccess", extract(@"Remote-Address=([^,]+)",1,SyslogMessage), ""),
    AuthCommandSet = case(EventType=="ISEAuthSuccess", extract(@"MatchedCommandSet=([^,]+)",1,SyslogMessage), ""),
    AuthAuthorizationRule = case(EventType=="ISEAuthSuccess", extract(@"AuthorizationPolicyMatchedRule=([^,]+)",1,SyslogMessage), ""),
    AuthAccessService = case(EventType=="ISEAuthSuccess", extract(@"SelectedAccessService=([^,]+)",1,SyslogMessage), ""),
    AuthIdentityStore = case(EventType=="ISEAuthSuccess", extract(@"AuthenticationIdentityStore=([^,]+)",1,SyslogMessage), ""),
    AuthMethod = case(EventType=="ISEAuthSuccess", extract(@"AuthenticationMethod=([^,]+)",1,SyslogMessage), ""),
    AuthNetworkDevice = case(EventType=="ISEAuthSuccess", extract(@"NetworkDeviceName=([^,]+)",1,SyslogMessage), ""),
    AuthSessionID = case(EventType=="ISEAuthSuccess", extract(@"AcsSessionID=([^,]+)",1,SyslogMessage), ""),
    AuthCPMSessionID = case(EventType=="ISEAuthSuccess", extract(@"CPMSessionID=([^,]+)",1,SyslogMessage), ""),
    AuthPolicySet = case(EventType=="ISEAuthSuccess", extract(@"ISEPolicySetName=([^,]+)",1,SyslogMessage), ""),
    AuthUserType = case(EventType=="ISEAuthSuccess", extract(@"UserType=([^,]+)",1,SyslogMessage), ""),
    AuthIdentityGroups = case(EventType=="ISEAuthSuccess", extract_all(@"IdentityGroup=([^,]+)",SyslogMessage), dynamic(null)),
    AuthSteps = case(EventType=="ISEAuthSuccess", extract_all(@"Step=(\d+)",SyslogMessage), dynamic(null)),
    AuthStepData = case(EventType=="ISEAuthSuccess", extract_all(@"StepData=\d+=([^,]+)",SyslogMessage), dynamic(null)),
    AuthCommand = case(EventType=="ISEAuthSuccess", extract(@"CmdAV=([^ ]+)",1,SyslogMessage), ""),
    AuthCommandArgument = case(EventType=="ISEAuthSuccess", extract(@"CmdArgAV=([^ ]+)",1,SyslogMessage), ""),
    AuthTotalLatencyMs = case(EventType=="ISEAuthSuccess", extract(@"TotalAuthenLatency=(\d+)",1,SyslogMessage), ""),
    AuthClientLatencyMs = case(EventType=="ISEAuthSuccess", extract(@"ClientLatency=(\d+)",1,SyslogMessage), "")
| extend//      --- Authentication Failure ---
    FailureUser = case(EventType=="ISEAuthFailure", extract(@"UserName=([^,]+)",1,SyslogMessage), ""),
    FailureResult = case(EventType=="ISEAuthFailure", "AuthenticationFailed", ""),
    FailureReasonCode = case(EventType=="ISEAuthFailure", extract(@"FailureReason=(\d+)",1,SyslogMessage), ""),
    FailureReasonText = case(EventType=="ISEAuthFailure", extract(@"FailureReason=\d+\s*([^,]+)",1,SyslogMessage), ""),
    FailureDetailedInfo = case(EventType=="ISEAuthFailure", extract(@"DetailedInfo=([^,]+)",1,SyslogMessage), ""),
    FailureAuthMethod = case(EventType=="ISEAuthFailure", extract(@"AuthenticationMethod=([^,]+)",1,SyslogMessage), ""),
    FailureIdentityStore = case(EventType=="ISEAuthFailure", extract(@"AuthenticationIdentityStore=([^,]+)",1,SyslogMessage), ""),
    FailureAccessService = case(EventType=="ISEAuthFailure", extract(@"SelectedAccessService=([^,]+)",1,SyslogMessage), ""),
    FailureDeviceIP = case(EventType=="ISEAuthFailure", extract(@"Device IP Address=([^,]+)",1,SyslogMessage), ""),
    FailureNasIP = case(EventType=="ISEAuthFailure", extract(@"NAS-IP-Address=([^,]+)",1,SyslogMessage), ""),
    FailureNasPort = case(EventType=="ISEAuthFailure", extract(@"NAS-Port=([^,]+)",1,SyslogMessage), ""),
    FailureNasIdentifier = case(EventType=="ISEAuthFailure", extract(@"NAS-Identifier=([^,]+)",1,SyslogMessage), ""),
    FailureCallingStationMAC = case(EventType=="ISEAuthFailure", extract(@"Calling-Station-ID=([^,]+)",1,SyslogMessage), ""),
    FailureEndpointMAC = case(EventType=="ISEAuthFailure", extract(@"EndPointMACAddress=([^,]+)",1,SyslogMessage), ""),
    FailureNetworkDevice = case(EventType=="ISEAuthFailure", extract(@"NetworkDeviceName=([^,]+)",1,SyslogMessage), ""),
    FailurePolicySet = case(EventType=="ISEAuthFailure", extract(@"ISEPolicySetName=([^,]+)",1,SyslogMessage), ""),
    FailureIdentityPolicy = case(EventType=="ISEAuthFailure", extract(@"IdentityPolicyMatchedRule=([^,]+)",1,SyslogMessage), ""),
    FailureEapTunnel = case(EventType=="ISEAuthFailure", extract(@"EapTunnel=([^,]+)",1,SyslogMessage), ""),
    FailureEapAuth = case(EventType=="ISEAuthFailure", extract(@"EapAuthentication=([^,]+)",1,SyslogMessage), ""),
    FailureSessionID = case(EventType=="ISEAuthFailure", extract(@"AcsSessionID=([^,]+)",1,SyslogMessage), ""),
    FailureCPMSessionID = case(EventType=="ISEAuthFailure", extract(@"CPMSessionID=([^,]+)",1,SyslogMessage), ""),
    FailureLatencyMs = case(EventType=="ISEAuthFailure", extract(@"RequestLatency=(\d+)",1,SyslogMessage), ""),
    FailureSteps = case(EventType=="ISEAuthFailure", extract_all(@"Step=(\d+)",SyslogMessage), dynamic(null)),
    FailureStepData = case(EventType=="ISEAuthFailure", extract_all(@"StepData=\d+=([^,]+)",SyslogMessage), dynamic(null)),
    FailureAccountLocked = case(EventType=="ISEAuthFailure" and SyslogMessage has "LOCKED", true, false),
    FailureIdentityRestricted = case(EventType=="ISEAuthFailure", extract(@"IdentityAccessRestricted=([^,]+)",1,SyslogMessage), "")
    | extend //      --- Authentication Failure PART 2 ---
    FailureUnknownUser = EventType=="ISEAuthFailure" and SyslogMessage has "ERROR_NO_SUCH_USER",
    FailureSubjectNotFound = EventType=="ISEAuthFailure" and SyslogMessage has "Subject not found",
    AuthProtocol = case(EventType=="ISEAuthFailure", extract(@"Protocol=([^,]+)",1,SyslogMessage), ""),
    AuthAction = case(EventType=="ISEAuthFailure", extract(@"Action=([^,]+)",1,SyslogMessage), ""),
    AuthService = case(EventType=="ISEAuthFailure", extract(@"Service=([^,]+)",1,SyslogMessage), ""),
    AuthPrivilegeLevel = case(EventType=="ISEAuthFailure", extract(@"Privilege-Level=([^,]+)",1,SyslogMessage), ""),
    AuthMethod = case(EventType=="ISEAuthFailure", extract(@"AuthenticationMethod=([^,]+)",1,SyslogMessage), ""),
    AuthUser = case(EventType=="ISEAuthFailure", extract(@"UserName=([^,]+)",1,SyslogMessage), ""),
    AuthDeviceIP = case(EventType=="ISEAuthFailure", extract(@"Device IP Address=([^,]+)",1,SyslogMessage), ""),
    AuthDestinationIP = case(EventType=="ISEAuthFailure", extract(@"DestinationIPAddress=([^,]+)",1,SyslogMessage), ""),
    AuthRemoteAddress = case(EventType=="ISEAuthFailure", extract(@"Remote-Address=([^,]+)",1,SyslogMessage), ""),
    AuthNetworkDevice = case(EventType=="ISEAuthFailure", extract(@"NetworkDeviceName=([^,]+)",1,SyslogMessage), ""),
    AuthPolicySet = case(EventType=="ISEAuthFailure", extract(@"ISEPolicySetName=([^,]+)",1,SyslogMessage), ""),
    AuthIdentityRule = case(EventType=="ISEAuthFailure", extract(@"IdentitySelectionMatchedRule=([^,]+)",1,SyslogMessage), "")
    | extend//      --- Alarm ---
    AlarmMessage = case(EventType=="ISEAlarm", extract(@"INFO:\s*(.+?)\s+NAS IP",1,SyslogMessage), ""),
    AlarmNASIP = case(EventType=="ISEAlarm", extract(@"NAS IP Address=([^ ]+)",1,SyslogMessage), ""),
    AlarmNASIdentifier = case(EventType=="ISEAlarm", extract(@"NAS Identifier=([^ ]+)",1,SyslogMessage), ""),
    AlarmUser = case(EventType=="ISEAlarm", extract(@"User Name=([^ ]+)",1,SyslogMessage), ""),
    AlarmUnknownSGT = EventType=="ISEAlarm",EventType=="ISEAlarm" and SyslogMessage has "Unknown SGT"
    | extend//      --- Tacacs Accounting ---
    TacacsAccountingState = case(EventType=="ISETacacsAccounting", extract(@"TACACS\+\s+Accounting\s+(START|STOP)",1,SyslogMessage), ""),
    TacacsDeviceIP = case(EventType=="ISETacacsAccounting", extract(@"Device IP Address=([^,]+)",1,SyslogMessage), ""),
    TacacsDeviceName = case(EventType=="ISETacacsAccounting", extract(@"NetworkDeviceName=([^,]+)",1,SyslogMessage), ""),
    TacacsUser = case(EventType=="ISETacacsAccounting", extract(@"User=([^,]+)",1,SyslogMessage), ""),
    TacacsPrivilegeLevel = case(EventType=="ISETacacsAccounting", extract(@"Privilege-Level=([^,]+)",1,SyslogMessage), ""),
    TacacsPort = case(EventType=="ISETacacsAccounting", extract(@"Port=([^,]+)",1,SyslogMessage), ""),
    TacacsRemoteIP = case(EventType=="ISETacacsAccounting", extract(@"Remote-Address=([^,]+)",1,SyslogMessage), ""),
    TacacsService = case(EventType=="ISETacacsAccounting", extract(@"Service=([^,]+)",1,SyslogMessage), ""),
    TacacsTaskId = case(EventType=="ISETacacsAccounting", extract(@"AVPair=task_id=([^,]+)",1,SyslogMessage), ""),
    TacacsElapsedSeconds = case(EventType=="ISETacacsAccounting", extract(@"AVPair=elapsed_time=([^,]+)",1,SyslogMessage), ""),
    TacacsStartTime = case(EventType=="ISETacacsAccounting", extract(@"AVPair=start_time=([^,]+)",1,SyslogMessage), ""),
    TacacsStopTime = case(EventType=="ISETacacsAccounting", extract(@"AVPair=stop_time=([^,]+)",1,SyslogMessage), ""),
    TacacsAccountingResult = case(EventType=="ISETacacsAccounting", extract(@"AcctReply-Status=([^ }]+)",1,SyslogMessage), "")
    | extend
    TacacsDiagReason = case(EventType=="ISETacacsDiagnostics", extract(@"TACACS\+ authentication request ([^,]+)",1,SyslogMessage), ""),
    TacacsDiagDeviceIP = case(EventType=="ISETacacsDiagnostics", extract(@"Device IP Address=([^,]+)",1,SyslogMessage), ""),
    TacacsDiagDevicePort = case(EventType=="ISETacacsDiagnostics", extract(@"Device Port=([^,]+)",1,SyslogMessage), ""),
    TacacsDiagUser = case(EventType=="ISETacacsDiagnostics", extract(@"User=([^,]+)",1,SyslogMessage), ""),
    TacacsDiagRemoteIP = case(EventType=="ISETacacsDiagnostics", extract(@"Remote-Address=([^,]+)",1,SyslogMessage), ""),
    TacacsDiagPort = case(EventType=="ISETacacsDiagnostics", extract(@"Port=([^,]+)",1,SyslogMessage), ""),
    TacacsDiagAuthType = case(EventType=="ISETacacsDiagnostics", extract(@"Authen-Type=([^,]+)",1,SyslogMessage), ""),
    TacacsDiagPrivilegeLevel = case(EventType=="ISETacacsDiagnostics", extract(@"Privilege-Level=([^,]+)",1,SyslogMessage), ""),
    TacacsDiagSessionId = case(EventType=="ISETacacsDiagnostics", extract(@"SessionId=([^,]+)",1,SyslogMessage), ""),
    TacacsDiagResult = case(EventType=="ISETacacsDiagnostics", extract(@"Authen-Reply-Status=([^ }]+)",1,SyslogMessage), ""),
    TacacsDiagSingleConnect = case(EventType=="ISETacacsDiagnostics", extract(@"EnableSingleConnect=([^,]+)",1,SyslogMessage), "")
    | extend
    AuditPurgeAction = case(
    EventType=="ISEAuditPurge" and SyslogMessage has "purging", "Purging",
    EventType=="ISEAuditPurge" and SyslogMessage has "Total Data", "ThresholdCheck",
    EventType=="ISEAuditPurge" and SyslogMessage has "completed successfully", "PURGED",""),
    AuditPurgeOlderThan = case(EventType=="ISEAuditPurge", extract(@"older than ([0-9A-Z\-]+)",1,SyslogMessage), ""),
    AuditPurgeThresholdGB = case(EventType=="ISEAuditPurge", extract(@"threshold[_ ]space\s*=\s*([0-9]+)\s*GB",1,SyslogMessage), ""),
    AuditPurgeUsedSpaceGB = case(EventType=="ISEAuditPurge", extract(@"used[_ ]space\s*=\s*([0-9]+)\s*GB",1,SyslogMessage), ""),
    AuditPurgeCompleted = case(EventType=="ISEAuditPurge" and SyslogMessage has "completed successfully", true, dynamic(null))
    | project-reorder TimeGenerated, EventTime, SourceSystem, Computer, HostName, EventType
    | project-away _ResourceId, MG, TenantId, ProcessName
